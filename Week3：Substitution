        char key[LENG + 1];
        for (int i = 0; i < LENG; i++)
        {
            key[i] = toupper(key0[i]);
        }
        key[LENG] = '\0';
        if (LENG == 26)
        {
            string plaintext0 = get_string("Plaintext: \n");
            const int LENGTH = strlen(plaintext0);
            char plaintext[LENGTH + 1];
            for (int i = 0; i < LENGTH; i++)
            {
                plaintext[i] = toupper(plaintext0[i]);
            }
            plaintext[LENGTH] = '\0';
            char ciphertext[LENGTH + 1];
            for (int i = 0 ; i < LENGTH ; i++)
            {
                int loct = plaintext[i] - 65;
                ciphertext[i] = key[loct];
